# Headless Linux x86_64 / Python 3.12 dependencies of the pinned upstream
# source, with patches/headless-security.patch applied. All transitive packages
# are hash-locked; source installs use --no-deps --no-build-isolation.
# Delete both locks before regenerating from the kit root:
#
#   uv pip compile runners/chatterbox-narration/requirements.in --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_39 \
#     --exclude-newer 2026-10-28 --output-file runners/chatterbox-narration/requirements.lock.txt
#   printf 'pip\nsetuptools\nwheel\n' | uv pip compile - --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_39 --exclude-newer 2026-10-28 \
#     -c runners/chatterbox-narration/requirements.lock.txt \
#     --output-file runners/chatterbox-narration/requirements-build.lock.txt
# Keep --exclude-newer at least one week behind the regeneration date.

