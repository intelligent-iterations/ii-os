{
  "1": {
    "inputs": {"file": "seedvr2-input.mp4"},
    "class_type": "LoadVideo",
    "_meta": {"title": "Load source video"}
  },
  "2": {
    "inputs": {"video": ["1", 0]},
    "class_type": "GetVideoComponents",
    "_meta": {"title": "Source frames and FPS"}
  },
  "3": {
    "inputs": {
      "model": "seedvr2_ema_3b_fp16.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "swap_io_components": false,
      "offload_device": "none",
      "cache_model": false,
      "attention_mode": "sdpa"
    },
    "class_type": "SeedVR2LoadDiTModel",
    "_meta": {"title": "SeedVR2 3B FP16"}
  },
  "4": {
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": false,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": false,
      "decode_tile_size": 1024,
      "decode_tile_overlap": 128,
      "tile_debug": "false",
      "offload_device": "none",
      "cache_model": false
    },
    "class_type": "SeedVR2LoadVAEModel",
    "_meta": {"title": "SeedVR2 FP16 VAE"}
  },
  "5": {
    "inputs": {
      "image": ["2", 0],
      "dit": ["3", 0],
      "vae": ["4", 0],
      "seed": 42,
      "resolution": 1080,
      "max_resolution": 1920,
      "batch_size": 5,
      "uniform_batch_size": false,
      "temporal_overlap": 1,
      "prepend_frames": 0,
      "color_correction": "lab",
      "input_noise_scale": 0.0,
      "latent_noise_scale": 0.0,
      "offload_device": "none",
      "enable_debug": true
    },
    "class_type": "SeedVR2VideoUpscaler",
    "_meta": {"title": "Upscale video"}
  },
  "6": {
    "inputs": {"images": ["5", 0], "fps": ["2", 2]},
    "class_type": "CreateVideo",
    "_meta": {"title": "Encode at source FPS"}
  },
  "7": {
    "inputs": {
      "video": ["6", 0],
      "filename_prefix": "ii-os/video",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {"title": "Save upscaled video"}
  }
}
