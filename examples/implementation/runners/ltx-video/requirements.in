# What the ltx-video image installs, before resolution. The Dockerfile
# installs the installer from requirements-build.lock.txt, then
# requirements.lock.txt, generated from this file, both with
# `pip install --require-hashes --no-deps`, so every package (dependencies
# included) is pinned to an exact version and hash. After changing anything
# here or a revision in the Dockerfile, delete both lock files (uv keeps an
# existing lock's pins) and regenerate them from the kit root:
#
#   uv pip compile runners/ltx-video/requirements.in --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_39 \
#     --index-url https://pypi.org/simple \
#     --exclude-newer 2026-10-28 --output-file runners/ltx-video/requirements.lock.txt
#   printf 'pip>=26.2.2\nsetuptools>=84.1.0\nwheel\n' | uv pip compile - --generate-hashes \
#     --python-version 3.12 --python-platform x86_64-manylinux_2_39 --exclude-newer 2026-10-28 \
#     -c runners/ltx-video/requirements.lock.txt \
#     --output-file runners/ltx-video/requirements-build.lock.txt
#
# Python 3.12 and glibc 2.39 are the image's Ubuntu 24.04 base. Set
# --exclude-newer to a date at least a week back, so no release younger than
# that enters the lock.

# Build tooling the image has always upgraded to.
setuptools>=84.1.0
wheel

# PyTorch from PyPI, whose 2.13 wheels use CUDA 13.0. The toolkit supplies
