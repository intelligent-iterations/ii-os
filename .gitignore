# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# `/build/` is root-anchored, so it does not cover the in-repo packages. Their
# build output is 65 MB and one `git add -A` away from being committed.
/packages/*/build/
/packages/*/example/build/
/coverage/
/web/ffmpeg/*
!/web/ffmpeg/.gitkeep
.firebase/
.firebase.*.json
functions/.env*
functions/.secret.local
/functions/bin/server

# Local configuration and credentials
.env
.env.*
.env*
CLAUDE.local.md
AGENTS.local.md
secrets/
*.key
*.pem
*-credentials.json
*-service-account.json
gha-creds-*.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
test/failures/
