{
  "version": 1,
  "id": "ii-os-project",
  "width": 1280,
  "height": 720,
  "framesPerSecond": 30,
  "durationMicros": 12000000,
  "backgroundColor": "101014",
  "output": {
    "container": "webm",
    "videoCodec": "vp9",
    "audioCodec": "opus",
    "videoBitrate": 3000000,
    "audioBitrate": 96000
